# CivicLens AI Environment Configuration
PROJECT_NAME="CivicLens AI"
VERSION="2.0.0"
API_V1_PREFIX="/api/v1"

# Database (Default: SQLite WAL in backend folder)
DATABASE_URL="sqlite:///./backend/civiclens.db"
# For production PostgreSQL (Render/Supabase/Neon/AWS RDS):
# DATABASE_URL="postgresql://user:password@host:5432/civiclens_db"

# Security (Set a strong random secret for production deployments)
JWT_SECRET="replace_with_a_secure_random_jwt_secret_for_production"
SECRET_KEY="replace_with_a_secure_random_jwt_secret_for_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Engine Configuration ("REAL" for ONNX deep learning or "DEMO" for deterministic heuristic fallback)
AI_INFERENCE_MODE="REAL"
AI_MODEL_NAME="CivicLens-YOLOv8-RDD2022 (ONNX Deep Learning Engine)"

# Uploads Configuration (10MB limit)
MAX_UPLOAD_SIZE_BYTES=10485760
